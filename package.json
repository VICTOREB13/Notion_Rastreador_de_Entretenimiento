{
  "name": "notion-rastreador-entretenimiento",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --filter \"@repo/*\" typecheck",
    "db:generate": "bun --filter @repo/database db:generate",
    "db:migrate": "bun --filter @repo/database db:migrate",
    "db:push": "bun --filter @repo/database db:push",
    "db:seed": "bun --filter @repo/database db:seed",
    "server:dev": "bun --filter @repo/server dev",
    "server:start": "bun --filter @repo/server start",
    "web:dev": "bun --filter @repo/web dev",
    "web:build": "bun --filter @repo/web build",
    "web:start": "bun --filter @repo/web start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "docker:pull": "docker compose pull",
    "test:all": "bun test ./.agents/scripts ./.agents/plugins/antigravity-harness-core/tests ./scripts",
    "test:harness": "bun test ./.agents/scripts ./.agents/plugins/antigravity-harness-core/tests ./scripts",
    "test:plugin": "bun test ./.agents/plugins/antigravity-harness-core/tests",
    "plugin:validate": "agy plugin validate .agents/plugins/antigravity-harness-core --strict",
    "test:artifacts": "bun scripts/validate_existing_artifacts.ts",
    "pack:task": "bun scripts/pack_task.ts",
    "lint:contracts": "bun scripts/lint_contracts.ts",
    "breaker:status": "bun .agents/scripts/circuit_breaker.ts --status",
    "breaker:reset": "bun .agents/scripts/circuit_breaker.ts --reset",
    "distill": "bun .agents/scripts/distill_session.ts",
    "worktree:add": "bun scripts/worktree.ts add",
    "worktree:remove": "bun scripts/worktree.ts remove",
    "worktree:list": "bun scripts/worktree.ts list",
    "verify:loop": "bun scripts/verify_recursive_loop.ts",
    "validate": "bun run test:artifacts && bun run lint:contracts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.13.0",
    "confbox": "^0.3.1",
    "typescript": "^5.8.0"
  }
}
