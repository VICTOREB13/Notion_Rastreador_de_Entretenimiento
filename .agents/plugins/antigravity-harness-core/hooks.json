{
  "antigravity-harness-core": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bun run ./src/hook_entry.ts session_start",
        "timeout": 15
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "bun run ./src/hook_entry.ts pre_invocation",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ./src/hook_entry.ts pre_tool_use",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ./src/hook_entry.ts post_tool_use",
            "timeout": 15
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "bun run ./src/hook_entry.ts post_invocation",
        "timeout": 15
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bun run ./src/hook_entry.ts stop_guardian",
        "timeout": 20
      }
    ]
  }
}
