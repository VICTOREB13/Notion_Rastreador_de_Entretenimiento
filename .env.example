# ==============================================================================
# Notion Rastreador de Entretenimiento - Environment Configuration
# ==============================================================================

# Server & Network Configuration (External Host Ports)
HOST_PORT_WEB=20010
HOST_PORT_API=20011
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (SQLite local-first with WAL mode)
DATABASE_URL="file:./data/entertainment.db"

# Notion API Integration
NOTION_TOKEN=secret_your_notion_integration_token_here
DB_ID_GAMES=your_notion_games_database_id_here
DB_ID_MOVIES=your_notion_movies_database_id_here
NOTION_POLL_INTERVAL_MS=120000

# Steam Web API Integration
STEAM_KEY=your_steam_web_api_key_here
STEAM_USER_ID=your_steam_64bit_community_id_here
STEAM_POLL_INTERVAL_MS=60000
STEAM_GRACE_PERIOD_MS=180000

# Google Gemini AI Enrichment Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Metadata Providers (RAWG & TMDB)
RAWG_KEY=your_rawg_api_key_here
TMDB_KEY=your_tmdb_api_key_here

# Frontend Showcase Web Configuration
INTERNAL_API_URL=http://daemon-api:3001
NEXT_PUBLIC_API_URL=/api
